# apps/mobile/.env.example — copy to apps/mobile/.env (gitignored). Expo loads .env from apps/mobile/, not the repo root.
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle: never put secrets (e.g. the service role key) here.

# Supabase API URL. Local stack: `npx supabase status` → "API URL".
#   Web / iOS simulator on this PC: http://127.0.0.1:44321
#   Physical phone in Expo Go:      http://<your PC's LAN IP>:44321   (e.g. http://192.168.1.23:44321; same Wi-Fi)
#   Android emulator:               http://10.0.2.2:44321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321

# Public anon key: the anon JWT or the `sb_publishable_…` key from `npx supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. EAS project id (from `eas init`). Without it remote push notifications are disabled;
# the in-app notification inbox still works.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional overrides for the web map styles (defaults: OpenFreeMap, no key needed).
EXPO_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Only for standalone / development builds (Google Maps). Expo Go needs none of these.
# Read in app.config.ts by the react-native-maps config plugin. Not EXPO_PUBLIC_: never inlined into JS.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Local Edge Function secrets (copy to supabase/functions/.env — gitignored).
# Used by `npm run functions:serve` (supabase functions serve --env-file supabase/functions/.env).
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by the Supabase runtime.

# Must equal the vault secret 'bojo_dispatch_secret' (seeds/00_local_vault.sql uses this dev placeholder).
PUSH_DISPATCH_SECRET=local-dev-dispatch-secret
# Optional: Expo access token if "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

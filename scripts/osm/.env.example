# Overpass endpoints (tried in order, then OVERPASS_FALLBACK_URLS, with exponential backoff).
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
# Optional contact appended to the User-Agent ("bojo-osm-import/0.1 (dev; <contact>)").
# Empty by default. Never put a personal email here unless its owner explicitly agreed.
OVERPASS_CONTACT=
# Give up on a query after this many minutes of retries across all endpoints.
OVERPASS_MAX_WAIT_MIN=15
